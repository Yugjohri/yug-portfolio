# Copy to .env (never committed) and fill in. Both are required for a
# production build; `npm run dev` works without them (the notes board then
# keeps notes in this browser only).
#
# Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. It is public by design (it ships in the site's
# JS); row-level security does the protecting. NEVER put the service-role key here.
VITE_SUPABASE_ANON_KEY=your-anon-key
