# Netlify. Hashed build assets and versioned font files never change: cache for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
# Unhashed media in public/ (the header clip, posters, the resume): a day.
/*.mp4
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.pdf
  Cache-Control: public, max-age=86400
# The page itself: always revalidated, so a deploy shows up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
